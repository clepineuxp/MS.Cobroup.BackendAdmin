{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IdentityDatabase": ""
  },
  "Identity": {
    "Issuer": "https://localhost:7119/",
    "SeedClientsOnStartup": false,
    "Clients": {
      "Admin": {
        "LoginUri": "http://localhost:5300/login",
        "RedirectUri": "http://localhost:5300/auth/callback",
        "PostLogoutRedirectUri": "http://localhost:5300/"
      },
      "Operational": {
        "LoginUri": "http://localhost:5200/login",
        "RedirectUri": "http://localhost:5200/auth/callback",
        "PostLogoutRedirectUri": "http://localhost:5200/"
      }
    }
  },
  "Jwt": {
    "SigningProvider": "EphemeralRsa",
    "AllowEphemeralSigning": false
  },
  "OperationalApi": {
    "BaseUrl": "https://localhost:7088/"
  }
}
